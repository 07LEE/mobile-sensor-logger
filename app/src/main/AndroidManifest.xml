<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- The capture path is the camera; the preview needs OpenGL ES 3.0. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Sensor Logger"
        android:hasCode="true"
        android:allowBackup="false">

        <service
            android:name="com.sensor.logger.RecordingService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <activity
            android:name="com.google.androidgamesdk.GameActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|density"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">

            <!-- Name of the native library GameActivity loads. -->
            <meta-data android:name="android.app.lib_name" android:value="sensor_logger" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
